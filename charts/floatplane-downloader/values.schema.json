{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "floatplane": {
      "type": "object",
      "properties": {
        "credentials": {
          "type": "object",
          "properties": {
            "mfa": {
              "type": "string",
              "description": "OTP token (mfa). Must be a quoted string, an unquoted YAML number loses its leading zeros."
            }
          }
        }
      }
    }
  }
}
